# ==============================================================================
# Sports Turf & Box Cricket Booking System - Environment Variables
# ==============================================================================

# Database Provider: "sqlite" (default for local dev/testing) or "supabase"
DATABASE_PROVIDER=sqlite

# Local SQLite database file path (used when DATABASE_PROVIDER=sqlite)
SQLITE_DB_PATH=./data/turf-bookings.db

# Supabase PostgreSQL Configuration (used when DATABASE_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Dashboard Authentication
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret-key

# Automated Owner Notification Webhook (BotSailor / Make.com / n8n)
# Receives HTTP POST JSON payload on every new booking.
# Example: https://your-webhook-url.example.com/turf-booking
ADMIN_WEBHOOK_URL=

# Fallback Admin WhatsApp Number (international format without + or spaces, e.g. 8801712345678)
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=8801712345678

# Turf Branding
NEXT_PUBLIC_TURF_NAME=Emerald Arena Turf & Box Cricket
NEXT_PUBLIC_TURF_LOCATION=Dhanmondi / Mirpur Sports Zone, Dhaka
